generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  PHOTO
  VIDEO
}

enum MediaStatus {
  ACTIVE
  MISSING
  BROKEN
  DUPLICATE
}

enum ScanStatus {
  RUNNING
  COMPLETED
  FAILED
}

model Folder {
  id        String   @id @default(cuid())
  path      String   @unique
  name      String
  parentId  String?
  parent    Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  Folder[] @relation("FolderHierarchy")
  media     Media[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Media {
  id             String      @id @default(cuid())
  fileHash       String      @unique
  filename       String
  title          String?
  relativePath   String      @unique
  absolutePath   String
  type           MediaType
  extension      String
  fileSize       BigInt
  width          Int?
  height         Int?
  aspectRatio    Float?
  duration       Float?
  status         MediaStatus @default(ACTIVE)
  folderId       String?
  folder         Folder?     @relation(fields: [folderId], references: [id])
  metadata       Metadata?
  thumbnails     Thumbnail[]
  viewStats      ViewStatistics[]
  fileCreatedAt  DateTime?
  fileModifiedAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([type])
  @@index([status])
  @@index([folderId])
  @@index([filename])
  @@index([createdAt])
  @@index([fileModifiedAt])
  @@index([type, status])
}

model Metadata {
  id            String   @id @default(cuid())
  mediaId       String   @unique
  media         Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  camera        String?
  lens          String?
  iso           Int?
  aperture      String?
  shutterSpeed  String?
  focalLength   String?
  gpsLatitude   Float?
  gpsLongitude  Float?
  orientation   Int?
  colorProfile  String?
  bitrate       Int?
  codec         String?
  fps           Float?
  audioChannels Int?
  hasSubtitles  Boolean  @default(false)
  dominantColor String?
  blurDataUrl   String?
  tags          String[] @default([])
  extraJson     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Thumbnail {
  id        String   @id @default(cuid())
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  size      String
  path      String
  width     Int
  height    Int
  fileHash  String
  createdAt DateTime @default(now())

  @@unique([mediaId, size])
  @@index([mediaId])
}

model ViewStatistics {
  id                String    @id @default(cuid())
  mediaId           String
  media             Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  deviceId          String
  viewCount         Int       @default(0)
  playCount         Int       @default(0)
  resumeCount       Int       @default(0)
  completionPercent Float     @default(0)
  watchDuration     Float     @default(0)
  lastViewedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([mediaId, deviceId])
  @@index([deviceId])
  @@index([viewCount])
}

model DeviceAnalytics {
  id               String   @id @default(cuid())
  deviceId         String   @unique
  totalVisits      Int      @default(0)
  galleryOpens     Int      @default(0)
  photoOpens       Int      @default(0)
  videoOpens       Int      @default(0)
  deviceType       String?
  browser          String?
  os               String?
  screenResolution String?
  language         String?
  theme            String?
  timezone         String?
  searchQueries    Json     @default("[]")
  filterUsage      Json     @default("{}")
  sortUsage        Json     @default("{}")
  firstVisitAt     DateTime @default(now())
  lastVisitAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ScanHistory {
  id                  String     @id @default(cuid())
  status              ScanStatus @default(RUNNING)
  startedAt           DateTime   @default(now())
  completedAt         DateTime?
  filesScanned        Int        @default(0)
  filesAdded          Int        @default(0)
  filesUpdated        Int        @default(0)
  filesDeleted        Int        @default(0)
  filesRenamed        Int        @default(0)
  thumbnailsGenerated Int        @default(0)
  errors              Json       @default("[]")
  triggeredBy         String
  createdAt           DateTime   @default(now())

  @@index([startedAt])
  @@index([status])
}

model ScannerSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  action    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}
