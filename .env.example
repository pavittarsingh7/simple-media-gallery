# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/media_gallery?schema=public"

# Media paths (absolute or relative to project root)
MEDIA_ROOT="./media"
PHOTO_FOLDER="photos"
VIDEO_FOLDER="videos"
THUMBNAIL_FOLDER="./.thumbnails"

# Scanner
SCAN_ON_STARTUP="true"
SCAN_SCHEDULE_ENABLED="false"
SCAN_SCHEDULE_CRON="0 */6 * * *"

# Security
ADMIN_SECRET="change-me-in-production"
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW_MS="60000"

# App
NEXT_PUBLIC_APP_NAME="Media Gallery"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
